FACTORY_DEF {*} StringReplacerFactory    FACTORY_NAME { $(Parcel_Number_Cleaner_WORKSPACE_NAME)_replace_with_sngl_spc }    INPUT  FEATURE_TYPE "$(Parcel_Number_Cleaner_WORKSPACE_NAME)_Input"    INPUT  FEATURE_TYPE "$(Parcel_Number_Cleaner_WORKSPACE_NAME)_Loop_to_string_replacement"    USE_REGEX { YES }    CASE_SENSITIVE { NO }    SOURCE_ATTRIBUTES { PARCELID }    FIND_TEXT { "<openparen><space><space><closeparen>+" }    REPLACE_TEXT { "<space>" }    REPLACE_NO_MATCH { "_FME_NO_OP_" }    OUTPUT { OUTPUT FEATURE_TYPE "$(Parcel_Number_Cleaner_WORKSPACE_NAME)_replace_with_sngl_spc_OUTPUT"          }
