FACTORY_DEF {*} TestFactory    FACTORY_NAME { $(Parcel_Number_Cleaner_WORKSPACE_NAME)_find_dbl_spaces }    INPUT  FEATURE_TYPE "$(Parcel_Number_Cleaner_WORKSPACE_NAME)_replace_with_sngl_spc_OUTPUT"    CASE_SENSITIVE_TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>PARCELID<closeparen>,$(Parcel_Number_Cleaner_WORKSPACE_NAME)_find_dbl_spaces)" CONTAINS_REGEX <openparen><space><space><closeparen>+ ENCODED }    BOOLEAN_OPERATOR { OR }    COMPOSITE_TEST_EXPR { "<Unused>" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE "$(Parcel_Number_Cleaner_WORKSPACE_NAME)_find_dbl_spaces_PASSED"         }    OUTPUT { FAILED FEATURE_TYPE "$(Parcel_Number_Cleaner_WORKSPACE_NAME)_find_dbl_spaces_FAILED"         }
