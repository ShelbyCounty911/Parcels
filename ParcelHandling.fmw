FACTORY_DEF {*} TestFactory    FACTORY_NAME { Filter_Out_Invalid }    INPUT  FEATURE_TYPE AttributeManager_OUTPUT    TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>ParcelID<closeparen>,Filter_Out_Invalid)" CONTAINS_REGEX <openbracket>0-9A-Z<closebracket><opencurly>5<closecurly><space><openbracket>0-9A-Z<closebracket><opencurly>5<closecurly> ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>ParcelID<closeparen>,Filter_Out_Invalid)" CONTAINS_REGEX <openbracket>0-9A-Z<closebracket><opencurly>6<closecurly><space><openbracket>0-9A-Z<closebracket><opencurly>6<closecurly> ENCODED } TEST { ParcelID ATTRIBUTE_VALUE_NULL "" ENCODED } TEST { ParcelID ATTRIBUTE_IS_EMPTY "" ENCODED } TEST { ParcelID ATTRIBUTE_IS_MISSING "" ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>ParcelID<closeparen>,Filter_Out_Invalid)" = <space> ENCODED } TEST { "@EvaluateExpression(FDIV,STRING_ENCODED,<at>Value<openparen>ParcelID<closeparen>,Filter_Out_Invalid)" = <space><space> ENCODED }    BOOLEAN_OPERATOR { COMPOSITE }    COMPOSITE_TEST_EXPR { "1 OR 2 AND NOT ( 3 OR 4 OR 5 OR 6 OR 7 )" }    PRESERVE_FEATURE_ORDER { PER_OUTPUT_PORT }    OUTPUT { PASSED FEATURE_TYPE Filter_Out_Invalid_PASSED         }
