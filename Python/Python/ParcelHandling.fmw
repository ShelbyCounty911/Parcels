xedCase_Exceptions_<lt>lt<gt>UNFILTERED<lt>gt<gt><quote><space><space><space>OUTPUT<space>FEATURE_TYPE<space><quote><dollar><openparen>Title_Case_WORKSPACE_NAME<closeparen>_Output<quote><lf>INCLUDE<space><openbracket>puts<space><opencurly>MACRO<space>WB_CURRENT_CONTEXT<space><dollar><openparen>WB_OLD_CONTEXT_<dollar><openparen>Title_Case_WORKSPACE_NAME<closeparen><closeparen><closecurly><closebracket><lf>    MULTI_PROCESS { EXTREME }     INPUT Input FEATURE_TYPE Title_Case_Input    OUTPUT Output FEATURE_TYPE Title_Case_Output
FACTORY_DEF * TeeFactory   FACTORY_NAME "Title_Case Output Output Renamer/Nuker"   INPUT FEATURE_TYPE Title_Case_Output   OUTPUT FEATURE_TYPE Title_Case_Output
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "Clean_up_ParcelID Input Input Collector"   INPUT FEATURE_TYPE Title_Case_Output   OUTPUT FEATURE_TYPE Clean_up_ParcelID_Input
MACRO Clean_up_ParcelID_WORKSPACE_NAME Clean_up_ParcelID
MACRO $(Clean_up_ParcelID_WORKSPACE_NAME)_TRANSFORMER_GROUP 
MACRO $(Clean_up_ParcelID_WORKSPACE_NAME)_XFORMER_NAME Clean_up_ParcelID
MACRO $(Clean_up_ParcelID_WORKSPACE_NAME)___COMPOUND_PARAMETERS 
MACRO $(Clean_up_ParcelID_WORKSPACE_NAME)__PARCELID <at>Value<openparen>_ParcelID<closeparen>
MACRO $(Clean_up_ParcelID_WORKSPACE_NAME)_SUB_DOC_NAME Clean up ParcelID
MACRO $(Clean_up_ParcelID_WORKSPACE_NAME)_SUB_DOC_NAME Clean up ParcelID
DEFAULT_MACRO Clean_up_ParcelID_WORKSPACE_NAME ""
INCLUDE [puts {MACRO WB_OLD_CONTEXT_$(Clean_up_ParcelID_WORKSPACE_NAME) $(WB_CURRENT_CONTEXT)};          puts {MACRO WB_CURRENT_CONTEXT $(Clean_up_ParcelID_WORKSPACE_NAME)}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(Clean_up_ParcelID_WORKSPACE_NAME)_Spaces_Loop1770749335 Input Splitter"   INPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Spaces_Loop"   OUTPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Spaces_Loop"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(Clean_up_ParcelID_WORKSPACE_NAME)_Input1770749335 Input Splitter"   INPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Input"   OUTPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Input_0_XDPm2urJW1E=" "@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING_FDIV_TYPED,_ParcelID,$($(Clean_up_ParcelID_WORKSPACE_NAME)__PARCELID),UTF8, FEATURE_TYPE)"   OUTPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Input_1_XEUnudFMpZw=" "@EvaluateExpression(ATTR_CREATE_EXPR_PROPAGATE_MISSING_FDIV_TYPED,_ParcelID,$($(Clean_up_ParcelID_WORKSPACE_NAME)__PARCELID),UTF8, FEATURE_TYPE)"
# -------------------------------------------------------------------------
FACTORY_DEF {*} StringValueFactory    FACTORY_NAME { $(Clean_up_ParcelID_WORKSPACE_NAME)_trim_ends_only }    INPUT  FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Input_1_XEUnudFMpZw="    FACTORY_MODE ATTRIBUTE_TRIMMER    SRC_ATTRS { _ParcelID }    TRIM_TYPE { "BOTH" }    TRIM_CHARS { "<space>" }    TRIM_TO_NONE { "Yes" }    OUTPUT { OUTPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_trim_ends_only_OUTPUT"          }
# -------------------------------------------------------------------------
FACTORY_DEF {*} TeeFactory    FACTORY_NAME { $(Clean_up_ParcelID_WORKSPACE_NAME)_Junction }    INPUT  FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_trim_ends_only_OUTPUT"    OUTPUT { FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Junction_Output"         }
# -------------------------------------------------------------------------
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(Clean_up_ParcelID_WORKSPACE_NAME)_Replace_Double_Spaces (Disabled) Nuker"   INPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Spaces_Loop"   INPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Input_0_XDPm2urJW1E="
FACTORY_DEF * BranchingFactory   TARGET_FACTORY "$(Clean_up_ParcelID_WORKSPACE_NAME)_Spaces_Loop1770749335 Input Splitter"   FACTORY_NAME "Loop to $(Clean_up_ParcelID_WORKSPACE_NAME)_Spaces_Loop1770749335 Input Splitter"   MAXIMUM_COUNT -1   OUTPUT PASSED FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Spaces_Loop"
FACTORY_DEF * TeeFactory   FACTORY_NAME "$(Clean_up_ParcelID_WORKSPACE_NAME)_Output1770749335 Output Collector"   INPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Junction_Output"   INPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Check_Spaces_Again_FAILED"   OUTPUT FEATURE_TYPE "$(Clean_up_ParcelID_WORKSPACE_NAME)_Output"
INCLUDE [puts {MACRO WB_CURRENT_CONTEXT $(WB_OLD_CONTEXT_$(Clean_up_ParcelID_WORKSPACE_NAME))}]
FACTORY_DEF * TeeFactory   FACTORY_NAME "Clean_up_ParcelID Output Output Renamer/Nuker"   INPUT FEATURE_TYPE Clean_up_ParcelID_Output   OUTPUT FEATURE_TYPE Clean_up_ParcelID_Output
# -------------------------------------------------------------------------
