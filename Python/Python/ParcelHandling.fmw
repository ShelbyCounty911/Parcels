INCLUDE [    if { {MATCH} == {EXCEPT} } {       puts {MACRO Change_Detector_ATTRMATCH MATCH_ALL_ATTRS_EXCEPT { Comments EditDate Effective Expire ExtResrce OBJECTID ParAddress ParOwn ParOwn2 ParOwn3 ParOwnTel ParStName ParStNum ParStType ParcelID Source SubdName UploadAuth UploadDate Shape_Area Shape_Length } };    }    elseif { {MATCH} == {ALL} } {       puts {MACRO Change_Detector_ATTRMATCH MATCH_ALL_ATTRIBUTES};    }    elseif { {MATCH} == {MATCH} } {       puts {MACRO Change_Detector_ATTRMATCH MATCH_ATTRIBUTES { Comments EditDate Effective Expire ExtResrce OBJECTID ParAddress ParOwn ParOwn2 ParOwn3 ParOwnTel ParStName ParStNum ParStType ParcelID Source SubdName UploadAuth UploadDate Shape_Area Shape_Length } };    }    else {       puts {MACRO Change_Detector_ATTRMATCH MATCH_ATTRIBUTES};    };    if { {ORIGINAL} == {REVISED} } {       puts {MACRO Change_Detector_OUTPUT_UNCHANGED_MACRO       };    }    elseif { {ORIGINAL} == {BOTH} } {       puts {MACRO Change_Detector_OUTPUT_UNCHANGED_MACRO       };    }    else {       puts {MACRO Change_Detector_OUTPUT_UNCHANGED_MACRO       };    }; ]
